{
  "name": "onrecord",
  "version": "1.2.0",
  "description": "화면과 소리를 간편하게 기록하는 Windows 데스크톱 앱",
  "main": "src/main.js",
  "private": true,
  "author": "OnRecord",
  "scripts": {
    "start": "electron .",
    "check": "node --check src/main.js && node --check src/preload.js && node --check src/renderer.js && node --check src/preferences-store.js && node --check src/region-controller.js && node --check src/region.js && node --check src/controls.js",
    "test": "node tests/smoke.cjs",
    "test:audio": "node tests/audio-quality.cjs",
    "test:preferences": "node tests/preferences.cjs",
    "test:saving": "node tests/recording-finalization.cjs",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "com.onrecord.desktop",
    "productName": "OnRecord",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "zip",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "icon": "src/assets/onrecord-icon.ico",
      "signExecutable": false
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mistle0108/OnRecord.git"
  }
}
